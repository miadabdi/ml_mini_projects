# ------------------------------------------------------
# 1. Virtual Environments (Recursive)
# ------------------------------------------------------
# This ignores .venv directories in the root and any subdirectories
.venv/
venv/
env/
ENV/

# ------------------------------------------------------
# 2. Python Core & Compiled Files
# ------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ------------------------------------------------------
# 3. Machine Learning Data & Artifacts
# ------------------------------------------------------
# Ignore standard data folders (Adjust naming to your preference)
data/
datasets/
raw_data/
processed_data/

# Ignore large compressed files (prevent accidental commits)
*.zip
*.tar.gz
*.tgz
*.rar
*.7z

# Ignore Model Weights and Serialized Objects
*.pkl
*.pickle
*.h5
*.hdf5
*.json
*.pth
*.pt
*.onnx
*.pb
*.tflite
model.png

# ------------------------------------------------------
# 4. Jupyter Notebooks
# ------------------------------------------------------
.ipynb_checkpoints
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# ------------------------------------------------------
# 5. Logs and Monitoring (Tensorboard, WandB, MLFlow)
# ------------------------------------------------------
logs/
runs/
wandb/
.wandb/
mlruns/
lightning_logs/

# ------------------------------------------------------
# 6. Environment Variables & Secrets (CRITICAL)
# ------------------------------------------------------
.env
.env.local
.env.*.local
secrets.json

# ------------------------------------------------------
# 7. IDE & Editor Configs
# ------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store